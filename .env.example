# API origin (backend). Use "/" to go through the Vite dev proxy on port 3000.
VITE_API_URL=http://localhost:8080

# WebSocket origin (STOMP). Leave empty to derive from VITE_API_URL.
VITE_WS_URL=

# Public Paystack key for the inline checkout (optional; server initializes first).
VITE_PAYSTACK_PUBLIC_KEY=

# Public Google OAuth entry point on the backend (usually derived from API URL).
VITE_GOOGLE_OAUTH_URL=/oauth2/authorization/google
